if [ $USE_ZLIB_NG = YES ]; then
    ngx_openssl_opt=
    ngx_openssl_zlib_conflict=NO

    for ngx_opt in $OPENSSL_OPT; do
        case "$ngx_opt" in
            zlib | enable-zlib | no-zlib \
            | zlib-dynamic | enable-zlib-dynamic | no-zlib-dynamic \
            | --with-zlib-include=* | --with-zlib-lib=*)
                ngx_openssl_zlib_conflict=YES
            ;;

            *)
                ngx_openssl_opt="$ngx_openssl_opt $ngx_opt"
            ;;
        esac
    done

    if [ $ngx_openssl_zlib_conflict = YES ]; then
        cat << END

$0: warning: native zlib-ng support is incompatible with OpenSSL zlib options.
OpenSSL zlib-related options in --with-openssl-opt are ignored and replaced
with "no-zlib" for the OpenSSL subbuild.

END
    fi

    OPENSSL_OPT="$ngx_openssl_opt no-zlib"
fi


case "$CC" in

    cl)

        case "$NGX_MACHINE" in

            amd64)
                OPENSSL_TARGET=VC-WIN64A
            ;;

            arm64)
                OPENSSL_TARGET=VC-WIN64-ARM
            ;;

            *)
                OPENSSL_TARGET=VC-WIN32
            ;;

        esac

        case $ngx_openssl_out_of_tree in
            YES)
                ngx_openssl_target="$ngx_openssl_install/include/openssl/ssl.h"
            ;;

            *)
                ngx_openssl_target="$OPENSSL/openssl/include/openssl/ssl.h"
            ;;
        esac

        ngx_openssl_make_src=$ngx_openssl_src
        ngx_openssl_make_build=$ngx_openssl_build

        if [ "$ngx_dirsep" != "/" ]; then
            ngx_openssl_target=`echo "$ngx_openssl_target" \
                | sed -e "s/\//$ngx_regex_dirsep/g"`
            ngx_openssl_make_src=`echo "$ngx_openssl_make_src" \
                | sed -e "s/\//$ngx_regex_dirsep/g"`
            ngx_openssl_make_build=`echo "$ngx_openssl_make_build" \
                | sed -e "s/\//$ngx_regex_dirsep/g"`
        fi

        cat << END                                            >> $NGX_MAKEFILE

$ngx_openssl_target:	$NGX_MAKEFILE
	\$(MAKE) -f auto/lib/openssl/makefile.msvc			\
		OPENSSL="$OPENSSL" OPENSSL_OPT="$OPENSSL_OPT"		\
		OPENSSL_TARGET="$OPENSSL_TARGET"			\
		OPENSSL_SRC="$ngx_openssl_make_src"		\
		OPENSSL_BUILD="$ngx_openssl_make_build"		\
		OPENSSL_OUT_OF_TREE="$ngx_openssl_out_of_tree"

END

    ;;

    bcc32)

        case $ngx_openssl_out_of_tree in
            YES)
                ngx_openssl_target="$ngx_openssl_install/include/openssl/ssl.h"
                ngx_openssl_libssl="$ngx_openssl_install/lib/libssl.lib"
                ngx_openssl_libcrypto="$ngx_openssl_install/lib/libcrypto.lib"
            ;;

            *)
                ngx_openssl_target="$OPENSSL/openssl/include/openssl/ssl.h"
                ngx_openssl_libssl="$OPENSSL/openssl/lib/ssleay32.lib"
                ngx_openssl_libcrypto="$OPENSSL/openssl/lib/libeay32.lib"
            ;;
        esac

        ngx_opt=`echo "-DOPENSSL=\"$OPENSSL\" -DOPENSSL_OPT=\"$OPENSSL_OPT\" \
            -DOPENSSL_SRC=\"$ngx_openssl_src\" \
            -DOPENSSL_BUILD=\"$ngx_openssl_build\" \
            -DOPENSSL_OUT_OF_TREE=\"$ngx_openssl_out_of_tree\"" \
            | sed -e "s/\//$ngx_regex_dirsep/g"`

        cat << END                                            >> $NGX_MAKEFILE

`echo "$ngx_openssl_libcrypto:					\
	$ngx_openssl_target"						\
	| sed -e "s/\//$ngx_regex_dirsep/g"`

`echo "$ngx_openssl_libssl:					\
	$ngx_openssl_target"						\
	| sed -e "s/\//$ngx_regex_dirsep/g"`

`echo "$ngx_openssl_target:	$NGX_MAKEFILE"			\
	| sed -e "s/\//$ngx_regex_dirsep/g"`
	\$(MAKE) -f auto/lib/openssl/makefile.bcc $ngx_opt

END

    ;;

    *)
        case $ngx_openssl_out_of_tree in
            YES)

                cat << END                                    >> $NGX_MAKEFILE

$ngx_openssl_install/include/openssl/ssl.h:	$NGX_MAKEFILE
	rm -rf $ngx_openssl_build
	mkdir -p $ngx_openssl_build
	cd $ngx_openssl_build \\
	&& $ngx_openssl_src/config --prefix=$ngx_openssl_prefix \\
		--libdir=lib no-shared no-threads $OPENSSL_OPT \\
	&& \$(MAKE) \\
	&& \$(MAKE) install_sw LIBDIR=lib

END

            ;;

            *)
                case $OPENSSL in
                    /*) ngx_prefix="$OPENSSL/.openssl" ;;
                    *)  ngx_prefix="$PWD/$OPENSSL/.openssl" ;;
                esac

                cat << END                                    >> $NGX_MAKEFILE

$OPENSSL/.openssl/include/openssl/ssl.h:	$NGX_MAKEFILE
	cd $OPENSSL \\
	&& if [ -f Makefile ]; then \$(MAKE) clean; fi \\
	&& ./config --prefix=$ngx_prefix no-shared no-threads $OPENSSL_OPT \\
	&& \$(MAKE) \\
	&& \$(MAKE) install_sw LIBDIR=lib

END

            ;;
        esac

    ;;

esac
