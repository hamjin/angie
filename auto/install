install_command()
{
    make_step_echo "$1" "$2"
    echo "	$res$3"                                      >> $NGX_MAKEFILE
}


install_mkdir()
{
    if [ "$NGX_PLATFORM" = win32 ]; then
        echo "	test -d '$1' || mkdir -p '$1'"             >> $NGX_MAKEFILE
        return
    fi

    make_step_echo MKDIR "$1"
    ngx_echo=${res#@}

    echo "	@test -d '$1' || { $ngx_echo mkdir -p '$1'; }" \
                                                             >> $NGX_MAKEFILE
}


install_copy_if_missing()
{
    if [ "$NGX_PLATFORM" = win32 ]; then
        echo "	test -f '$2' || cp $1 '$3'"                >> $NGX_MAKEFILE
        return
    fi

    make_step_echo INSTALL "$2"
    ngx_echo=${res#@}

    echo "	@if ! test -f '$2'; then $ngx_echo cp $1 '$3'; fi" \
                                                             >> $NGX_MAKEFILE
}


install_copy_dir_if_missing()
{
    if [ "$NGX_PLATFORM" = win32 ]; then
        echo "	test -d '$2' || cp -R $1 '$3'"             >> $NGX_MAKEFILE
        return
    fi

    make_step_echo INSTALL "$2"
    ngx_echo=${res#@}

    echo "	@if ! test -d '$2'; then $ngx_echo cp -R $1 '$3'; fi" \
                                                             >> $NGX_MAKEFILE
}


install_move_if_exists()
{
    if [ "$NGX_PLATFORM" = win32 ]; then
        echo "	test ! -f '$1' || mv '$1' '$2'"            >> $NGX_MAKEFILE
        return
    fi

    make_step_echo MOVE "$2"
    ngx_echo=${res#@}

    echo "	@if test -f '$1'; then $ngx_echo mv '$1' '$2'; fi" \
                                                             >> $NGX_MAKEFILE
}


if [ $USE_PERL != NO ]; then

    make_step_echo DESCEND "$NGX_OBJS/src/http/modules/perl"
    ngx_perl_echo=$res

    cat << END                                                >> $NGX_MAKEFILE

install_perl_modules:
	$ngx_perl_echo cd $NGX_OBJS/src/http/modules/perl && \$(MAKE) install
END

    NGX_INSTALL_PERL_MODULES=install_perl_modules

fi


case ".$NGX_SBIN_PATH" in
    ./*)
    ;;

    *)
        NGX_SBIN_PATH=$NGX_PREFIX/$NGX_SBIN_PATH
    ;;
esac


case ".$NGX_MODULES_PATH" in
    ./*)
    ;;

    *)
        NGX_MODULES_PATH=$NGX_PREFIX/$NGX_MODULES_PATH
    ;;
esac

NGX_MODULES_PATH=`dirname $NGX_MODULES_PATH/.`


case ".$NGX_CONF_PATH" in
    ./*)
    ;;

    *)
        NGX_CONF_PATH=$NGX_PREFIX/$NGX_CONF_PATH
    ;;
esac


NGX_CONF_PREFIX=`dirname $NGX_CONF_PATH`


case ".$NGX_PID_PATH" in
    ./*)
    ;;

    *)
        NGX_PID_PATH=$NGX_PREFIX/$NGX_PID_PATH
    ;;
esac


case ".$NGX_ERROR_LOG_PATH" in
    ./* | .)
    ;;

    *)
        NGX_ERROR_LOG_PATH=$NGX_PREFIX/$NGX_ERROR_LOG_PATH
    ;;
esac


case ".$NGX_HTTP_LOG_PATH" in
    ./*)
    ;;

    *)
        NGX_HTTP_LOG_PATH=$NGX_PREFIX/$NGX_HTTP_LOG_PATH
    ;;
esac


if test -f man/angie.8 ; then
    NGX_MAN=man/angie.8
else
    NGX_MAN=docs/man/angie.8
fi

if test -d html ; then
    NGX_HTML=html
else
    NGX_HTML=docs/html
fi

NGX_SBIN_DIR=`dirname "$NGX_SBIN_PATH"`
NGX_PID_DIR=`dirname "$NGX_PID_PATH"`
NGX_HTTP_LOG_DIR=`dirname "$NGX_HTTP_LOG_PATH"`

if test -n "$NGX_ERROR_LOG_PATH"; then
    NGX_ERROR_LOG_DIR=`dirname "$NGX_ERROR_LOG_PATH"`
fi

make_step_echo MAN "$NGX_OBJS/angie.8"
ngx_man_echo=$res

cat << END                                                    >> $NGX_MAKEFILE

manpage:	$NGX_OBJS/angie.8

$NGX_OBJS/angie.8:	$NGX_MAN $NGX_AUTO_CONFIG_H
	$ngx_man_echo sed -e "s|%%PREFIX%%|$NGX_PREFIX|" \\
		-e "s|%%PID_PATH%%|$NGX_PID_PATH|" \\
		-e "s|%%CONF_PATH%%|$NGX_CONF_PATH|" \\
		-e "s|%%ERROR_LOG_PATH%%|${NGX_ERROR_LOG_PATH:-stderr}|" \\
		< $NGX_MAN > \$@

install:	build $NGX_INSTALL_PERL_MODULES
END

install_mkdir "\$(DESTDIR)$NGX_PREFIX"
install_mkdir "\$(DESTDIR)$NGX_SBIN_DIR"
install_move_if_exists "\$(DESTDIR)$NGX_SBIN_PATH" \
                       "\$(DESTDIR)$NGX_SBIN_PATH.old"
install_command INSTALL "\$(DESTDIR)$NGX_SBIN_PATH" \
                "cp $NGX_OBJS/angie$ngx_binext '\$(DESTDIR)$NGX_SBIN_PATH'"

echo                                                        >> $NGX_MAKEFILE

install_mkdir "\$(DESTDIR)$NGX_CONF_PREFIX"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/koi-win" \
                "cp conf/koi-win '\$(DESTDIR)$NGX_CONF_PREFIX'"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/koi-utf" \
                "cp conf/koi-utf '\$(DESTDIR)$NGX_CONF_PREFIX'"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/win-utf" \
                "cp conf/win-utf '\$(DESTDIR)$NGX_CONF_PREFIX'"

echo                                                        >> $NGX_MAKEFILE

install_copy_if_missing "conf/mime.types" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX/mime.types" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/mime.types.default" \
                "cp conf/mime.types '\$(DESTDIR)$NGX_CONF_PREFIX/mime.types.default'"

install_copy_if_missing "conf/fastcgi_params" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX/fastcgi_params" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/fastcgi_params.default" \
                "cp conf/fastcgi_params '\$(DESTDIR)$NGX_CONF_PREFIX/fastcgi_params.default'"

install_copy_if_missing "conf/fastcgi.conf" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX/fastcgi.conf" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/fastcgi.conf.default" \
                "cp conf/fastcgi.conf '\$(DESTDIR)$NGX_CONF_PREFIX/fastcgi.conf.default'"

install_copy_if_missing "conf/uwsgi_params" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX/uwsgi_params" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/uwsgi_params.default" \
                "cp conf/uwsgi_params '\$(DESTDIR)$NGX_CONF_PREFIX/uwsgi_params.default'"

install_copy_if_missing "conf/scgi_params" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX/scgi_params" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/scgi_params.default" \
                "cp conf/scgi_params '\$(DESTDIR)$NGX_CONF_PREFIX/scgi_params.default'"

install_copy_if_missing "conf/prometheus_all.conf" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX/prometheus_all.conf" \
                        "\$(DESTDIR)$NGX_CONF_PREFIX"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/prometheus_all.conf.default" \
                "cp conf/prometheus_all.conf '\$(DESTDIR)$NGX_CONF_PREFIX/prometheus_all.conf.default'"

install_copy_if_missing "conf/angie.conf" \
                        "\$(DESTDIR)$NGX_CONF_PATH" \
                        "\$(DESTDIR)$NGX_CONF_PATH"
install_command INSTALL "\$(DESTDIR)$NGX_CONF_PREFIX/angie.conf.default" \
                "cp conf/angie.conf '\$(DESTDIR)$NGX_CONF_PREFIX/angie.conf.default'"

echo                                                        >> $NGX_MAKEFILE

install_mkdir "\$(DESTDIR)$NGX_PID_DIR"
install_mkdir "\$(DESTDIR)$NGX_HTTP_LOG_DIR"
install_copy_dir_if_missing "$NGX_HTML" \
                            "\$(DESTDIR)$NGX_PREFIX/html" \
                            "\$(DESTDIR)$NGX_PREFIX"


if test -n "$NGX_ERROR_LOG_PATH"; then
    install_mkdir "\$(DESTDIR)$NGX_ERROR_LOG_DIR"

fi


if test -n "$DYNAMIC_MODULES"; then
    install_mkdir "\$(DESTDIR)$NGX_MODULES_PATH"

fi


for ngx_module in $DYNAMIC_MODULES
do
    ngx_module=$ngx_module$ngx_modext

    install_move_if_exists "\$(DESTDIR)$NGX_MODULES_PATH/$ngx_module" \
                           "\$(DESTDIR)$NGX_MODULES_PATH/$ngx_module.old"
    install_command INSTALL "\$(DESTDIR)$NGX_MODULES_PATH/$ngx_module" \
                    "cp $NGX_OBJS/$ngx_module '\$(DESTDIR)$NGX_MODULES_PATH/$ngx_module'"

done


# create Makefile

cat << END >> Makefile

build:
	@\$(MAKE) -f $NGX_MAKEFILE

install:
	@\$(MAKE) -f $NGX_MAKEFILE install

modules:
	@\$(MAKE) -f $NGX_MAKEFILE modules

upgrade:
	$NGX_SBIN_PATH -t

	kill -USR2 \`cat $NGX_PID_PATH\`
	sleep 1
	test -f $NGX_PID_PATH.oldbin

	kill -QUIT \`cat $NGX_PID_PATH.oldbin\`

test:
	@\$(MAKE) -C tests/

.PHONY:	build install modules upgrade test
END
